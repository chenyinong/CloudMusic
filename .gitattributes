# 源码统一用 LF，Windows 脚本用 CRLF，避免跨平台协作时整文件被改写
* text=auto eol=lf

*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
gradlew text eol=lf

*.apk binary
*.ap_ binary
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.keystore binary
